# Template for secrets/<destination>.enc.env. Fill a copy, then encrypt:
#
#   cp secrets/example.env secrets/staging.env
#   sops --encrypt --input-type dotenv --output-type dotenv secrets/staging.env > secrets/staging.enc.env
#   shred -u secrets/staging.env      # (or delete; the plaintext must not remain)
#
# Edit later with `sops secrets/staging.enc.env` (decrypts in $EDITOR only).
# Every value here is consumed by .kamal/secrets and config/deploy.yml.

# GHCR pull for the deploy host. A fine-grained PAT with read:packages, or
# in CI the GITHUB_TOKEN.
KAMAL_REGISTRY_PASSWORD=

# --- Postgres accessory: set once; roles are created from these on first boot
POSTGRES_PASSWORD=
APP_USER_PASSWORD=
MIGRATOR_PASSWORD=
REGISTER_READER_PASSWORD=
BACKUP_PASSWORD=

# --- App runtime
# postgresql://app_user:<APP_USER_PASSWORD>@spiral-nexus-postgres:5432/spiral_nexus
DATABASE_URL=
# postgresql://migrator:<MIGRATOR_PASSWORD>@127.0.0.1:5432/spiral_nexus (via SSH tunnel from CI; see deploy.yml)
MIGRATOR_DATABASE_URL=
# Transitional: until the Clerk + data-layer PRs land, the app still talks to Supabase.
SUPABASE_SERVICE_ROLE_KEY=
