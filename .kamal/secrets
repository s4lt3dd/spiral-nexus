# Kamal secret resolution. Each line maps a name used in config/deploy.yml to
# a value from the environment of the process running `kamal`. CI populates
# that environment by decrypting secrets/<destination>.enc.env with sops.
# Locally: `bin/kamal` does the same via `sops exec-env`.
#
# Never put values here; this file is committed.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# App runtime
SUPABASE_SERVICE_ROLE_KEY=$SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=$DATABASE_URL

# Postgres accessory (first boot creates the roles with these)
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
APP_USER_PASSWORD=$APP_USER_PASSWORD
MIGRATOR_PASSWORD=$MIGRATOR_PASSWORD
REGISTER_READER_PASSWORD=$REGISTER_READER_PASSWORD
BACKUP_PASSWORD=$BACKUP_PASSWORD
