# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used for privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (added in the subscriptions slice; leave blank for now)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Payments switch. While "false" (or unset), every signed-in user gets a
# bounded MVP listing allowance so the free tier is usable without Stripe.
# Flip to "true" in the subscriptions slice to enforce the per-tier caps.
PAYMENTS_ENABLED=false

# IP-office ingestion (docs/INGESTION.md). While "false" (or unset), the EUIPO
# source ingests the committed fixture; flip to "true" only once the live feed
# is wired in lib/ingestion/sources/euipo.mjs.
INGESTION_LIVE=false
# EUIPO eSearch Plus API — only needed when INGESTION_LIVE=true and the
# eSearch (rather than Open Data bulk) path is chosen.
EUIPO_API_CLIENT_ID=
EUIPO_API_CLIENT_SECRET=
# Read-only Postgres connection for the internal register MCP, as the
# register_reader role (docs/INGESTION.md — "Enable the register MCP").
# Used by mcp/register-server, never by the app.
REGISTER_READONLY_DATABASE_URL=
