# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used for privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (added in the subscriptions slice; leave blank for now)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Payments switch. While "false" (or unset), every signed-in user gets a
# bounded MVP listing allowance so the free tier is usable without Stripe.
# Flip to "true" in the subscriptions slice to enforce the per-tier caps.
PAYMENTS_ENABLED=false
