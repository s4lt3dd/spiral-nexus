# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
mcp/register-server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template MUST be committed so others know which vars to set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env
.env*.local
app/page.boilerplate.txt

# stray debug logs
err.log
esbuild.err

# python bytecode (skill tooling)
__pycache__/
*.pyc

# Claude Code personal settings
.claude/settings.local.json

# self-hosted infra (docs/TARGET-ARCHITECTURE.md)
infra/tofu/**/.terraform/
infra/tofu/**/*.tfstate
infra/tofu/**/*.tfstate.*
infra/tofu/**/terraform.tfvars
infra/tofu/**/backend.hcl
infra/tofu/**/.terraform.lock.hcl
# decrypted secrets never touch disk unencrypted; only *.enc.env is committed
secrets/*
!secrets/*.enc.env
!secrets/example.env
!secrets/README.md
